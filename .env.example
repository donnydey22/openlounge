# ---- Server ----
PORT=3000
# Uploaded avatar images live here (and db.json when DATABASE_URL is unset).
# Point at a persistent volume in production (Railway: mount a volume at /data).
# DATA_DIR=/data

# ---- Storage (Postgres) ----
# Set → users, profiles/interests, follows, sessions, DMs, DM read cursors and open user rooms are stored in Postgres.
#       Migrations in server/migrations run automatically at boot. A fresh, empty database imports
#       $DATA_DIR/db.json once if it exists (set SKIP_JSON_IMPORT=1 to skip).
# Unset → local-dev fallback: everything is written to $DATA_DIR/db.json (logged at boot).
# Railway: add a Postgres service, then on the app service set DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://openlounge:openlounge@localhost:5432/openlounge
# TLS is chosen automatically: *.railway.internal → off (private network), *.rlwy.net public proxy → on without CA check
# (self-signed), ?sslmode=require → on without CA check. Override with: disable | require | verify
# DATABASE_SSL=
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_ATTEMPTS=15   # boot retries (2 s apart) while the database starts

# ---- LiveKit Cloud (drop-in audio) ----
# Create a project at https://cloud.livekit.io → Settings → Keys.
# Leave blank locally: rooms, hands, chat and DMs still work; the room shows "Live audio is off".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Self-hosted coturn for 1:1 calls (optional; server-only) ----
# The coturn static-auth-secret. Never prefix this with NEXT_PUBLIC_ or commit a real value.
# When unset, calls retain the established explicit-empty-ICE/TCP path.
# TURN_STATIC_SECRET=

# ---- Phone OTP ----
# demo (default): codes are shown on screen and 000000 always works — NEVER use in a public deployment.
SMS_PROVIDER=demo

# ---- Sign in with Google / Apple / email (docs/unified-auth.md) ----
# Each method shows up only when ALL of its variables are set; with none set the login screen is phone-only, as before.
# Public origin for OAuth redirect URIs and email links (production default https://openlounge.app; dev: request host).
# AUTH_PUBLIC_URL=https://openlounge.app
# Google (Cloud Console → OAuth client "Web application", redirect URI https://openlounge.app/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Apple (Services ID with return URL https://openlounge.app/auth/apple/callback + a Sign in with Apple key, team 9A6NA2ZAFH)
# APPLE_TEAM_ID=9A6NA2ZAFH
# APPLE_SERVICES_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # the .p8 contents; literal \n is fine
# Email + password needs outgoing mail for verification / reset links (587 = STARTTLS, 465 = TLS)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Open Lounge <hello@openlounge.app>"
# Local dev only (ignored in production): enable email sign-in without SMTP; links are printed to the server log.
# AUTH_EMAIL_DEV=1

# ---- Client (optional) ----
# Override the WebSocket endpoint (default: same origin, wss:// when the page is https://, path /ws)
# NEXT_PUBLIC_WS_URL=wss://openlounge.example.com/ws

# Demo population (bot users, seeded rooms, bot chat + DM auto-replies). Off unless set to 1.
# DEMO_SEED=1

# ---- Hardening (all optional; full list in docs/ops/operations.md) ----
# AUTH_SECRET=            # access-token signing key (falls back to the key stored in the DB); rotation: AUTH_SECRET_PREVIOUS=old1,old2
# CSP_REPORT_ONLY=1       # send CSP as Report-Only while testing
# METRICS_TOKEN=          # enables GET /metrics (Bearer) in production
# READYZ_REQUIRE_LIVEKIT=1
