# Copy to /etc/openlounge-mediasoup-sfu.env as root (chmod 0640 root:openlounge-sfu). Never commit that file.
# This service must target STAGING until the Chief of Staff explicitly approves a production canary.
OPENLOUNGE_GATEWAY_WS_URL=wss://STAGING_OPENLOUNGE_HOST/ws

# Generate two distinct 32+ byte random secrets. They must match the application staging environment, but are never
# exposed to browsers, logs, Git, screenshots, or coturn. Do not reuse TURN_STATIC_SECRET.
MEDIASOUP_GATEWAY_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_VALUE
MEDIASOUP_ADMISSION_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_VALUE

# Public IPv4 of the approved SFU host. Bind 0.0.0.0 and announce only this address.
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_ADDRESS=REPLACE_WITH_SFU_PUBLIC_IPV4

# Non-overlapping direct-UDP range. coturn retains 3478, 443 and 50000-60000.
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999

# Two concurrent pilot calls maximum on a 1-vCPU co-location host; do not raise without measured review.
MEDIASOUP_MAX_CALLS=2
# Loopback-only health endpoint; do not open this port in UFW/DO firewall.
MEDIASOUP_HEALTH_HOST=127.0.0.1
MEDIASOUP_HEALTH_PORT=8081
