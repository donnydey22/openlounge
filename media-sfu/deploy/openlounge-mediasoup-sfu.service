[Unit]
Description=Open Lounge brokered Mediasoup direct-UDP pilot
Documentation=https://github.com/donnydey22/openlounge
After=network-online.target coturn.service
Wants=network-online.target
ConditionPathExists=/etc/openlounge-mediasoup-sfu.env
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
User=openlounge-sfu
Group=openlounge-sfu
WorkingDirectory=/opt/openlounge-mediasoup-sfu/media-sfu
EnvironmentFile=/etc/openlounge-mediasoup-sfu.env
Environment=OPENLOUNGE_NODE_BIN=/opt/openlounge-node/bin/node
Environment=MEDIASOUP_WATCHDOG_START_TIMEOUT_SEC=60
ExecStart=/bin/bash deploy/run-with-watchdog.sh
Restart=always
RestartSec=5
TimeoutStartSec=75s
NotifyAccess=all
WatchdogSec=30s
WatchdogSignal=SIGABRT
KillMode=control-group
SyslogIdentifier=openlounge-mediasoup
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

# Separate cgroup with a hard ceiling so coturn has priority on the 1-vCPU/2-GB host.
Slice=openlounge-sfu.slice
CPUQuota=35%
CPUWeight=50
MemoryHigh=384M
MemoryMax=448M
TasksMax=128
LimitNOFILE=16384
OOMPolicy=stop

# Process isolation. Media needs IPv4/IPv6 UDP sockets and outbound WSS only; it has no privileged ports or shell access.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openlounge-mediasoup-sfu
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
