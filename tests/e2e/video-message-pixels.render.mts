import pw from "playwright";
import { phoneLogin } from "../unified-auth/harness";
const BASE="http://127.0.0.1:3356", WS="ws://127.0.0.1:3356/ws";
const ph=()=>`+1555${Math.floor(Math.random()*9e6+1e6)}`, sx=()=>Math.random().toString(36).slice(2,8);
const s=await phoneLogin(WS,ph(),{firstName:"Pix",username:`pix_${sx()}`}); const r=await phoneLogin(WS,ph(),{firstName:"V",username:`v_${sx()}`});
await r.client.req("dm:send",{to:s.res.user.id,text:"x"});
const b=await pw.chromium.launch({args:["--use-fake-ui-for-media-stream","--use-fake-device-for-media-stream","--use-file-for-fake-video-capture=/workspace/vm-lr.y4m"]});
const c=await b.newContext({permissions:["camera","microphone"] as any});
await c.addInitScript((x)=>{localStorage.setItem("openlounge:session",x.refresh);localStorage.setItem("openlounge:access",JSON.stringify({t:x.access,exp:Date.now()+3.6e6}));localStorage.setItem("openlounge:uid",x.uid);localStorage.setItem("openlounge:saved",String(Date.now()));},{refresh:s.res.refresh??s.res.token,access:s.res.access,uid:s.res.user.id});
await c.addInitScript(()=>{const M=window.MediaRecorder;(window as any).MediaRecorder=function(st:any,o:any){console.log("MR track",st.getVideoTracks().map((t:any)=>t.label+"|"+t.constructor.name).join(","));return new M(st,o)};(window as any).MediaRecorder.isTypeSupported=M.isTypeSupported;});
const p=await c.newPage(); p.on("console",m=>console.log("PAGE",m.text().slice(0,200))); await p.goto(`${BASE}/messages/${r.res.user.id}`,{waitUntil:"networkidle"});
const nn=p.getByRole("button",{name:"Not now"}); if(await nn.isVisible().catch(()=>false)) await nn.click();
await p.locator("[data-testid=attach-button]:visible").first().click(); await p.locator("[data-testid=attach-video-message]").click();
await p.waitForFunction(()=>!(document.querySelector("[data-testid=video-recorder-toggle]") as any)?.disabled);
const SAMPLE=`(async(v)=>{await new Promise(r=>setTimeout(r,800));const c=document.createElement("canvas");c.width=v.videoWidth;c.height=v.videoHeight;const g=c.getContext("2d");g.drawImage(v,0,0);const px=(x)=>Array.from(g.getImageData(Math.floor(x),Math.floor(c.height/2),1,1).data.slice(0,3));return {left:px(c.width*0.1),right:px(c.width*0.9),css:getComputedStyle(v).transform};})`;
const sample=(sel:string)=>p.locator(sel).evaluate((v,src)=>(0,eval)(src)(v),SAMPLE);
const raw=await sample("[data-testid=video-recorder-live]");
const t=p.locator("[data-testid=video-recorder-toggle]"); await t.click(); await new Promise(r=>setTimeout(r,1500)); await t.click();
await p.locator("[data-testid=video-recorder-review]").waitFor();
const rec=await sample("[data-testid=video-recorder-review]");
await p.locator("[data-testid=video-recorder-live]").count();
console.log(JSON.stringify({rawCameraPixels:raw,recordedFilePixels:rec}));
await p.screenshot({path:"/workspace/vmirror-out/pixel-review.png"});
await b.close(); s.client.close(); r.client.close(); process.exit(0);
