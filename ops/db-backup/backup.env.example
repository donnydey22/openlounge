# Install as /etc/openlounge-backups/backup.env (root:root, mode 0640, group readable by openlounge-backup only).
# Do not put a Railway URL, password, private age key, or recipient key in this repository.

# libpq reads the source connection from this service file and password file. Both live outside the repo.
PGSERVICEFILE=/etc/openlounge-backups/pg_service.conf
PGPASSFILE=/etc/openlounge-backups/.pgpass
BACKUP_PG_SERVICE=openlounge-backup-source

# The dedicated LUKS-encrypted mounted volume. The service fails and alerts unless the
# exact device-mapper source is mounted here; do not weaken either setting in production.
BACKUP_ROOT=/srv/openlounge-backups
BACKUP_REQUIRE_MOUNT=1
BACKUP_EXPECTED_MOUNT_SOURCE=/dev/mapper/openlounge-backups
BACKUP_AGE_RECIPIENT_FILE=/etc/openlounge-backups/age-recipients.txt
BACKUP_AGE_IDENTITY_FILE=/etc/openlounge-backups/age-identity.txt

# PostgreSQL 18 is required while Railway runs PostgreSQL 18. Use the distribution's exact binary directory.
BACKUP_PG_BIN=/usr/lib/postgresql/18/bin
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_WEEKLY_DAY=7
BACKUP_MIN_FREE_BYTES=1073741824
# Required free capacity is max(BACKUP_MIN_FREE_BYTES, source-size * multiplier + margin).
BACKUP_CAPACITY_MULTIPLIER=3
BACKUP_CAPACITY_MARGIN_BYTES=1073741824
BACKUP_SCRATCH_PORT=55442
BACKUP_SNAPSHOT_HOLD_SEC=1800
