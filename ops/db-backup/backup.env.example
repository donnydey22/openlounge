# Install as /etc/openlounge-backups/backup.env (root:openlounge-backup-verify, mode 0640).
# This is the DROPLET verifier configuration. It has no Railway URL, database password, SSH private key, or signing key.

BACKUP_ROOT=/srv/openlounge-backups
BACKUP_REQUIRE_MOUNT=1
BACKUP_EXPECTED_MOUNT_SOURCE=/dev/mapper/openlounge-backups
BACKUP_INCOMING_DIR=/srv/openlounge-backups/incoming
BACKUP_RECEIVER_GROUP=openlounge-backup-ingress
BACKUP_RECEIPT_STAGE_ROOT=/srv/openlounge-backups/.receipt-stage
BACKUP_STATE_DIR=/var/lib/openlounge-backup-verify
# Private age identity matching BACKUP_AGE_RESTORE_RECIPIENT in Railway. This is not the offline recovery identity.
BACKUP_AGE_IDENTITY_FILE=/etc/openlounge-backups/restore-test-age-identity.txt
# Minisign public key matching the sealed Railway signing key. This key is public and does not permit signing.
BACKUP_MANIFEST_VERIFY_KEY_FILE=/etc/openlounge-backups/manifest-verify.pub

# Railway currently runs PostgreSQL 18; the droplet needs matching pg_restore plus a temporary scratch server.
BACKUP_PG_BIN=/usr/lib/postgresql/18/bin
BACKUP_DAILY_KEEP=7
BACKUP_WEEKLY_KEEP=4
BACKUP_WEEKLY_DAY=7
BACKUP_MIN_FREE_BYTES=1073741824
# Required capacity: max(BACKUP_MIN_FREE_BYTES, source DB size × multiplier + margin).
BACKUP_CAPACITY_MULTIPLIER=3
BACKUP_CAPACITY_MARGIN_BYTES=1073741824
BACKUP_SCRATCH_PORT=55442
BACKUP_RESTORE_TIMEOUT_SEC=3600
# Partial encrypted uploads older than this are removed before receipt processing; no manifest is accepted from a partial.
BACKUP_PARTIAL_MAX_AGE_SEC=21600
