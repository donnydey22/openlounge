[Unit]
Description=Verify and retain Open Lounge Railway PostgreSQL backup
Documentation=file:///opt/openlounge-db-backups/docs/ops/postgres-backups.md
RequiresMountsFor=/srv/openlounge-backups
After=local-fs.target
OnFailure=openlounge-db-restore-verify-failure@%n.service

[Service]
Type=oneshot
User=openlounge-backup-verify
Group=openlounge-backup-verify
SupplementaryGroups=openlounge-backup-ingress
EnvironmentFile=/etc/openlounge-backups/backup.env
ExecStart=/opt/openlounge-db-backups/bin/openlounge-db-restore-verify.sh
UMask=0077
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=512M
TasksMax=96
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/srv/openlounge-backups /var/lib/openlounge-backup-verify
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlounge-db-restore-verify
