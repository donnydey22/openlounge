# Railway service: openlounge-db-backup (separate one-shot Cron service; never the web app).
# Set all placeholder values as SEALED Railway variables. Never commit actual values.
# This service must stay in the same Railway project/environment as Postgres.

# Private Railway networking only. The exporter rejects every other database host.
BACKUP_PGHOST=postgres.railway.internal
BACKUP_PGPORT=5432
BACKUP_PGDATABASE=openlounge
BACKUP_PGUSER=openlounge_backup_ro
BACKUP_PGPASSWORD=REPLACE_WITH_SEALED_READ_ONLY_ROLE_PASSWORD
# Authenticated TLS: CA PEM for the private postgres hostname, held as a sealed multiline variable.
BACKUP_PGSSLMODE=verify-full
BACKUP_PGSSLROOTCERT_PEM=REPLACE_WITH_SEALED_RAILWAY_POSTGRES_CA_PEM
BACKUP_CONNECT_TIMEOUT_SEC=20
BACKUP_EXPORT_TIMEOUT_SEC=3600
# Must exceed BACKUP_EXPORT_TIMEOUT_SEC. The holder is released immediately after the parallel consumers complete.
BACKUP_SNAPSHOT_HOLD_SEC=3900

# The fixed offline recovery recipient is compiled into the exporter. Supply the separate public key for
# the droplet's restore-test identity; it is a public age1... recipient, never the private identity.
BACKUP_AGE_RESTORE_RECIPIENT=REPLACE_WITH_DROPLET_RESTORE_TEST_AGE_RECIPIENT

# Minisign private key created for the Railway exporter; sealed multiline, generated without a passphrase for Cron.
# The matching public verification key is held on the droplet and never travels via SFTP.
BACKUP_MANIFEST_SIGNING_KEY=REPLACE_WITH_SEALED_MINISIGN_PRIVATE_KEY

# Restricted SFTP receiver on the existing Open Lounge media host. The target is fail-closed in code.
BACKUP_SFTP_TARGET=openlounge-backup@165.232.137.71
BACKUP_SFTP_REMOTE_DIR=incoming
BACKUP_SFTP_TIMEOUT_SEC=600
# Multiline, sealed OpenSSH private key; restrict it to the internal-sftp ingress account on the droplet.
BACKUP_SSH_PRIVATE_KEY=REPLACE_WITH_SEALED_SFTP_PRIVATE_KEY
# Pinned known_hosts line for 165.232.137.71, for example: "165.232.137.71 ssh-ed25519 AAAA..."
BACKUP_SSH_KNOWN_HOSTS=REPLACE_WITH_VERIFIED_MEDIA_HOST_SSH_HOST_KEY
