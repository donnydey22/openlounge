{
  "name": "openlounge",
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "private": true,
  "description": "Open Lounge — a Clubhouse-style social audio rooms MVP (Next.js + raw WebSockets + LiveKit)",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "next build && node scripts/legacy-chunks.mjs",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "reset-data": "node -e \"const fs=require('fs');fs.rmSync('data/db.json',{force:true});fs.rmSync('data/avatars',{recursive:true,force:true});console.log('demo data reset')\"",
    "db:import": "tsx scripts/import-db-json.ts",
    "smoke": "node scripts/smoke-ws.mjs",
    "test:time": "bash scripts/test-time.sh",
    "test:social": "tsx scripts/test-social-links.ts",
    "test:social-api": "node scripts/test-social-api.mjs",
    "test:auth": "node --import tsx --test --test-force-exit --test-concurrency=1 tests/unified-auth/*.test.ts",
    "test:push": "tsx scripts/test-push.ts",
    "test:biometrics": "node --import tsx --test tests/biometrics/*.test.ts",
    "test:hardening:unit": "node --import tsx --test tests/hardening/unit.test.ts",
    "test:memory": "node --import tsx --test --test-force-exit tests/hardening/memory.test.ts",
    "test:hardening": "node --import tsx --test --test-timeout=120000 tests/hardening/unit.test.ts tests/hardening/integration.test.ts",
    "loadtest:ws": "node --import tsx scripts/loadtest-ws.ts",
    "db:backup": "bash scripts/pg-backup.sh",
    "test:db-backups": "node --test tests/ops/db-backup.test.mjs",
    "test:db-backups:integration": "bash tests/ops/db-backup.integration.sh",
    "test:ugc": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/ugc-safety/*.test.ts",
    "test:reactions": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/reactions/*.test.ts",
    "test:typing": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/typing/*.test.ts",
    "test:store": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/store-compliance/*.test.ts",
    "test:calls": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/calls/*.test.ts",
    "test:invites": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/invites/*.test.ts",
    "test:groups": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/groups/*.test.ts",
    "test:presence": "node --import tsx --test --test-force-exit tests/presence/*.test.ts",
    "test:stickers": "DATA_DIR=$(mktemp -d) node --import tsx --test --test-force-exit --test-concurrency=1 tests/stickers/*.test.ts",
    "test:monet": "DATA_DIR=$(mktemp -d) node --import tsx --test --test-force-exit --test-concurrency=1 tests/monet/*.test.ts",
    "test:media": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=120000 tests/media/*.test.ts",
    "test:shared-media:render": "node --import tsx tests/e2e/shared-media-telegram.render.mts",
    "test:turn:relay": "node tests/e2e/turn-relay-harness.mjs",
    "test:turn:relay:config": "node --test tests/e2e/turn-relay-harness.test.mjs",
    "test:roomchat": "node --import tsx --test --test-force-exit --test-concurrency=1 --test-timeout=60000 tests/room-chat/*.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "hls.js": "^1.7.3",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.52.0",
    "mediasoup-client": "^3.24.5",
    "next": "^16.3.8",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "playwright": "^1.51.1",
    "postcss-preset-env": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "chrome >= 69",
    "and_chr >= 69",
    "safari >= 12",
    "ios_saf >= 12",
    "firefox >= 78",
    "edge >= 79",
    "samsung >= 10"
  ]
}
