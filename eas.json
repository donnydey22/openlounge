{
  "cli": {
    "version": ">= 24.11.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "buildConfiguration": "Release",
        "enterpriseProvisioning": "adhoc",
        "credentialsSource": "local"
      }
    },
    "production": {
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "ios": {
        "buildConfiguration": "Release",
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
